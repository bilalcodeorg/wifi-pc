{
    "version": 6,

    "configurePresets": [
        {
            "name": "mingw-base",
            "hidden": true,
            "generator": "Ninja",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Release",
                "BUILD_SHARED_LIBS": "OFF"
            }
        },
        {
            "name": "static-lib-windows-x64-release",
            "inherits": "mingw-base",
            "binaryDir": "${sourceDir}/build/static-lib-windows-x64-release",
            "cacheVariables": {
                "CMAKE_C_COMPILER": "x86_64-w64-mingw32-gcc",
                "CMAKE_CXX_COMPILER": "x86_64-w64-mingw32-g++"
            }
        },
        {
            "name": "shared-lib-windows-x64-release",
            "inherits": "static-lib-windows-x64-release",
            "binaryDir": "${sourceDir}/build/shared-lib-windows-x64-release",
            "cacheVariables": {
                "BUILD_SHARED_LIBS": "ON"
            }
        },
        {
            "name": "static-lib-windows-x86-release",
            "inherits": "mingw-base",
            "binaryDir": "${sourceDir}/build/static-lib-windows-x86-release",
            "cacheVariables": {
                "CMAKE_C_COMPILER": "i686-w64-mingw32-gcc",
                "CMAKE_CXX_COMPILER": "i686-w64-mingw32-g++"
            }
        },
        {
            "name": "shared-lib-windows-x86-release",
            "binaryDir": "${sourceDir}/build/shared-lib-windows-x86-release",
            "inherits": "static-lib-windows-x86-release",
            "cacheVariables": {
                "BUILD_SHARED_LIBS": "ON"
            }
        },
        {
            "name": "mingw-windows-arm64",
            "inherits": "mingw-base",
            "binaryDir": "${sourceDir}/build/mingw-windows-arm64",
            "cacheVariables": {
                "CMAKE_C_COMPILER": "aarch64-w64-mingw32-gcc",
                "CMAKE_CXX_COMPILER": "aarch64-w64-mingw32-g++"
            }
        }
    ],
    "buildPresets": [
        {
            "name": "static-lib-windows-x64-release",
            "configurePreset": "static-lib-windows-x64-release"
        },
        {
            "name": "static-lib-windows-x86-release",
            "configurePreset": "static-lib-windows-x86-release"
        },
        {
            "name": "shared-lib-windows-x86-release",
            "configurePreset": "shared-lib-windows-x86-release"
        },
        {
            "name": "mingw-windows-arm64",
            "configurePreset": "mingw-windows-arm64"
        }
    ]
}