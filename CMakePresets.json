{
    "version": 6,

    "configurePresets": [
        {
            "name": "mingw-base",
            "hidden": true,
            "generator": "Ninja",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Release"
            }
        },
        {
            "name": "mingw-windows-x64",
            "displayName": "MinGW Windows x64",
            "inherits": "mingw-base",
            "binaryDir": "${sourceDir}/build/mingw-windows-x64",
            "cacheVariables": {
                "CMAKE_C_COMPILER": "x86_64-w64-mingw32-gcc",
                "CMAKE_CXX_COMPILER": "x86_64-w64-mingw32-g++"
            }
        },
        {
            "name": "mingw-windows-x86",
            "displayName": "MinGW Windows x86",
            "inherits": "mingw-base",
            "binaryDir": "${sourceDir}/build/mingw-windows-x86",
            "cacheVariables": {
                "CMAKE_C_COMPILER": "i686-w64-mingw32-gcc",
                "CMAKE_CXX_COMPILER": "i686-w64-mingw32-g++"
            }
        },
        {
            "name": "mingw-windows-arm64",
            "displayName": "MinGW Windows ARM64",
            "inherits": "mingw-base",
            "binaryDir": "${sourceDir}/build/mingw-windows-arm64",
            "cacheVariables": {
                "CMAKE_C_COMPILER": "aarch64-w64-mingw32-gcc",
                "CMAKE_CXX_COMPILER": "aarch64-w64-mingw32-g++"
            }
        }
    ],
    "buildPresets": [
        {
            "name": "mingw-windows-x64",
            "configurePreset": "mingw-windows-x64"
        },
        {
            "name": "mingw-windows-x86",
            "configurePreset": "mingw-windows-x86"
        },
        {
            "name": "mingw-windows-arm64",
            "configurePreset": "mingw-windows-arm64"
        }
    ]
}